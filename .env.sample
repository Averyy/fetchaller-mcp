# fetchaller-mcp environment variables
# Copy this file to .env and fill in values

# Required: Bearer token for authentication
# Generate with: openssl rand -hex 32
MCP_API_KEY=your-secret-api-key-here

# Required for persistent deployments: signing secret for OAuth access tokens.
# Generate with: openssl rand -hex 32  (use a DIFFERENT value than MCP_API_KEY)
#
# Authenticated HTTP startup fails if this is unset. For local HTTP development
# only, ALLOW_EPHEMERAL_JWT=1 opts into a random per-process secret.
# Keep this value stable so access tokens survive restarts.
JWT_SECRET=your-jwt-signing-secret-here

# Optional: persistent OAuth state directory (default: /app/data)
DATA_DIR=/app/data

# Optional: OAuth access-token lifetime in seconds (default: 2592000 / 30 days)
ACCESS_TOKEN_TTL=2592000

# Optional: HTTP server port (default: 6000)
HTTP_PORT=6000

# Optional: Rate limit per IP per minute (default: 100)
RATE_LIMIT_REQUESTS=100

# Optional: Public URL for OAuth redirects (required for Claude.ai connectors)
# Default: http://localhost:$HTTP_PORT
MCP_SERVER_URL=https://mcp.fetchaller.com

# Optional: Mouser Search API key (free — register at mouser.com/MyMouser/MouserSearchApplication.aspx)
# Enables structured product data for Mouser URLs (bypasses Akamai WAF)
MOUSER_API_KEY=

# Optional: DigiKey API credentials (free — register at developer.digikey.com)
# Enables structured product data for DigiKey URLs (bypasses PerimeterX WAF)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
