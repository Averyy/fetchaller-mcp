# fetchaller-mcp environment variables
# Copy this file to .env and fill in values

# Required: Bearer token for authentication
# Generate with: openssl rand -hex 32
MCP_API_KEY=your-secret-api-key-here

# Optional: HTTP server port (default: 6000)
HTTP_PORT=6000

# Optional: Rate limit per IP per minute (default: 100)
RATE_LIMIT_REQUESTS=100

# Optional: Public URL for OAuth redirects (required for Claude.ai connectors)
# Default: http://localhost:$HTTP_PORT
MCP_SERVER_URL=https://mcp.fetchaller.com

# Optional: Mouser Search API key (free — register at mouser.com/MyMouser/MouserSearchApplication.aspx)
# Enables structured product data for Mouser URLs (bypasses Akamai WAF)
MOUSER_API_KEY=

# Optional: DigiKey API credentials (free — register at developer.digikey.com)
# Enables structured product data for DigiKey URLs (bypasses PerimeterX WAF)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
